rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    // رقم الهاتف من حساب الدخول: 9613123456@… أو 9613123456.v2@… ← +9613123456
    function myPhone() { return '+' + request.auth.token.email.split('@')[0].split('[.]')[0]; }
    function configDoc() { return /databases/$(database)/documents/config/main; }
    function isProjectAdmin() {
      return signedIn() && exists(configDoc()) && myPhone() in get(configDoc()).data.admins;
    }
    function isMember(sec) { return myPhone() in sec.memberPhones; }
    function isSectionAdmin(sec) { return sec.members.get(myPhone(), '') == 'admin'; }

    // إعدادات المشروع: مدراء المشروع وأنواع الأعمال
    match /config/main {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.admins == [myPhone()];
      allow update: if isProjectAdmin();
    }

    // أسماء الأعضاء: كل شخص يعدّل اسمه، ومدير المشروع يعدّل الجميع
    match /users/{phone} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isProjectAdmin() || (signedIn() && phone == myPhone());
    }

    // رقم نسخة الرمز السري لكل هاتف (لا يحوي الرمز نفسه)
    match /logins/{phone} {
      allow get: if true;
      allow list: if false;
      allow write: if isProjectAdmin();
    }

    // طلبات "نسيت رمزي"
    match /resets/{phone} {
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'phone', 'ts'])
        && request.resource.data.phone == phone
        && request.resource.data.name is string && request.resource.data.name.size() < 60;
      allow read, delete: if isProjectAdmin();
    }

    // الصفحات
    match /sections/{sectionId} {
      allow read: if signedIn() && (isProjectAdmin() || isMember(resource.data));
      allow create, delete: if isProjectAdmin();
      allow update: if signedIn() && (
        isProjectAdmin()
        || isSectionAdmin(resource.data)
        // العضو العادي يعدّل الختمة فقط
        || (isMember(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['khatma']))
      );
    }

    // الإهداءات: كل عضو يسجّل باسمه، والتعديل والحذف لمدير المشروع فقط
    match /logs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.resource.data.p == myPhone() || isProjectAdmin());
      allow update, delete: if isProjectAdmin();
    }
  }
}
